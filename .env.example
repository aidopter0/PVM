# Copy to .env (or run `npm run setup`, which generates one with a random password).

# Postgres credentials, used by `npm run setup` and docker compose to create the database
POSTGRES_USER=pvm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pvm
POSTGRES_PORT=5432

# How the app connects to Postgres (must match the values above)
DATABASE_URL=postgresql://pvm:change-me@localhost:5432/pvm

# App
API_PORT=3000
# Port the Docker image is published on (docker compose only)
WEB_PORT=8080
# Load demo products/stores/planogram into an empty database at startup
SEED_DEMO=false
